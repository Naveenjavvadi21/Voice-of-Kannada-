        "note": "'Yattha kadika' means which direction."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಓಡೆಗ್ ಪೋಪಿನಿ?",
        "phrase_transliteration": "Odeg popini?",
        "note": "Coastal regional idiom."
      }
    ]
  },
  {
    "standard_phrase": "ತುಂಬಾ ಧನ್ಯವಾದಗಳು",
    "standard_transliteration": "Tumba dhanyavaadagalu",
    "english": "Thank you very much",
    "cultural_note": "Gratitude expression.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಥ್ಯಾಂಕ್ಸ್ ಅಣ್ಣ, ತುಂಬಾ ಹೆಲ್ಪ್ ಆಯ್ತು",
        "phrase_transliteration": "Thanks anna, tumba help aaythu",
        "note": "Natural mix of English thanks with heartfelt Kannada."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಕೃತಜ್ಞತೆಗಳು ಬುದ್ಧಿ",
        "phrase_transliteration": "Kruthajnategalu buddhi",
        "note": "Classical formal 'Kruthajnathe' (gratitude)."
      },
      {
        "region": "Uttara Karnataka (Hubballi-Dharwad)",
        "phrase_kannada": "ದೊಡ್ಡ ಉಪಕಾರ ಆಯ್ತ್ರಿ!",
        "phrase_transliteration": "Dodda upakaara aaythree!",
        "note": "Acknowledges the deed as a 'big favor'."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಉಪಕಾರ ಮಲ್ತರ್ ಮಾರಾಯ್ರೆ!",
        "phrase_transliteration": "Upakaara malthar maraayre!",
        "note": "Grateful tone with coastal inflection."
      }
    ]
  }
]
