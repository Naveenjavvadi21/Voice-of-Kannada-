    "english": "Come here (Polite)",
    "cultural_note": "Used to beckon someone respectfully.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಸ್ವಲ್ಪ ಇಲ್ಲಿ ಬನ್ನಿ",
        "phrase_transliteration": "Svalpa illi banni",
        "note": "Adds 'Svalpa' (a little) to soften direct instructions."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ದಯಮಾಡಿ ಈ ಕಡೆ ಬನ್ನಿ",
        "phrase_transliteration": "Dayamaadi ee kade banni",
        "note": "'Dayamaadi' elevates politeness."
      },
      {
        "region": "Uttara Karnataka (Hubballi-Dharwad)",
        "phrase_kannada": "ಹಿಂಗ ಬರೀಲ್ಲೇನ್ರಿ!",
        "phrase_transliteration": "Hinga bareellenri!",
        "note": "'Hinga baree' is iconic northern vernacular."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಇಡೆಗ್ ಬಲೆ ಮಾರೆರೆ",
        "phrase_transliteration": "Ideg bale maarere",
        "note": "Coastal Tuluva-Kannada blend."
      }
    ]
  },
  {
    "standard_phrase": "ಹೋಗಿ ಬರುತ್ತೇನೆ",
    "standard_transliteration": "Hogi baruththene",
    "english": "I will go and return (Goodbye)",
    "cultural_note": "In Kannada culture, you never say 'I will go', you always say 'I will go and return'.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಬರ್ತೀನಿ ಬ್ರೋ / ಅಣ್ಣ, ಸಿಗೋಣ!",
        "phrase_transliteration": "Barteeni bro / anna, sigona!",
        "note": "Brisk and forward-looking."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಬರಲಾ ಬುದ್ಧಿ? ಅನುಮತಿ ಇರಲಿ",
        "phrase_transliteration": "Baralaa buddhi? Anumathi irali",
        "note": "Respectfully asking permission to take leave."
      },
      {
        "region": "Uttara Karnataka (Hubballi-Dharwad)",
        "phrase_kannada": "ಬರ್ತೇನ್ರಿ ನಾ ಹೋಗಿ!",
        "phrase_transliteration": "Barteenri naa hogi!",
        "note": "Energetic and firm tone."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಬರ್ಪೆ ಮಾರಾಯ್ರೆ!",
        "phrase_transliteration": "Barpe maraayre!",
        "note": "Warm, musical sign-off."
      }
    ]
  },
  {
    "standard_phrase": "ಎಲ್ಲಿ ಹೋಗುತ್ತಿದ್ದೀರಿ?",
