[
  {
    "standard_phrase": "ಹೇಗಿದ್ದೀರಾ?",
    "standard_transliteration": "Hegiddeera?",
    "english": "How are you?",
    "cultural_note": "Greeting styles differ noticeably across Karnataka's geographical zones.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಹೇಗಿದ್ದೀರಾ ಸರ್? ಏನ್ ಸಮಾಚಾರ?",
        "phrase_transliteration": "Hegiddeera sir? En samachara?",
        "note": "Fast-paced urban cadence, often paired with 'What's the news?'"
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಆರಾಮಾಗಿದ್ದೀರಾ ರೀ? ಕ್ಷೇಮವೇ?",
        "phrase_transliteration": "Aramaagiddeera ree? Kshemave?",
        "note": "Soft, musical cadence with the respectful suffix 'Ree'."
      },
      {
        "region": "Uttara Karnataka (Hubballi-Dharwad)",
        "phrase_kannada": "ಆರಾಮ್ ಅದೀರೇನ್ರಿ? ಯನ್ನಡಸೇತಿ?",
        "phrase_transliteration": "Aram adeerenri? Yennadseti?",
        "note": "Vibrant, earthy dialect. 'Aram adeerenri' is the signature greeting."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಸುಖ ಇದ್ದೀರಾ ಮಾರಾಯ್ರೆ?",
        "phrase_transliteration": "Sukha iddeera maraayre?",
        "note": "Uses coastal honorifics like 'Maraayre' (my dear friend/gentleman)."
      }
    ]
  },
  {
    "standard_phrase": "ಎಷ್ಟು ಆಯ್ತು?",
    "standard_transliteration": "Eshtu aaythu?",
    "english": "How much is the cost?",
    "cultural_note": "Essential when settling payments at markets and taxis.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಎಷ್ಟು ಆಯ್ತು ಬ್ರದರ್ / ಅಣ್ಣ?",
        "phrase_transliteration": "Eshtu aaythu brother / anna?",
        "note": "Casual blend of English and Kannada common in the IT capital."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಎಷ್ಟು ಆಯಿತು ಬುದ್ಧಿ?",
        "phrase_transliteration": "Eshtu aayithu buddhi?",
        "note": "'Buddhi' is a classic Mysuru deferential address."
      },
      {
        "region": "Uttara Karnataka (Hubballi-Dharwad)",
        "phrase_kannada": "ಖರ್ಚಿಟ್ರ ಆತ್ರೀ? ಎಷ್ಟು ಕೊಡ್ಬೇಕು?",
        "phrase_transliteration": "Kharchitra aathree? Esht kodbeku?",
        "note": "Characteristic elision and rhythmic elongation on 'tree'."
      },
      {
        "region": "Karavali / Coastal (Mangaluru-Udupi)",
        "phrase_kannada": "ಎಷ್ಟಾಂಡ್ ಮಾರ್‍ರೆ?",
        "phrase_transliteration": "Eshtaand maarre?",
        "note": "Distinct coastal Tulu-influenced Kannada phonetic merger."
      }
    ]
  },
  {
    "standard_phrase": "ಏನು ಮಾಡುತ್ತಿದ್ದೀರಿ?",
    "standard_transliteration": "Enu maaduttiddeeri?",
    "english": "What are you doing?",
    "cultural_note": "A frequent check-in phrase with family and colleagues.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಏನ್ ಮಾಡ್ತಿದ್ದೀರಾ?",
        "phrase_transliteration": "En maadtiddeera?",
        "note": "Shortened verb form standard in city conversations."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಏನು ಮಾಡೋದು ಆಗ್ತಾ ಇದೆ?",
