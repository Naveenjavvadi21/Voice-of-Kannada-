    "english": "Where are you going?",
    "cultural_note": "A common conversation starter when bumping into acquaintances.",
    "variants": [
      {
        "region": "Bengaluru (Urban)",
        "phrase_kannada": "ಎಲ್ಲಿ ಹೊರಟಿದ್ದೀರಾ?",
        "phrase_transliteration": "Elli horatiddeera?",
        "note": "Uses 'horatiddeera' (heading out)."
      },
      {
        "region": "Mysuru (Heritage / Royal)",
        "phrase_kannada": "ಎಲ್ಲಿಗೆ ಪಯಣ ರೀ?",
