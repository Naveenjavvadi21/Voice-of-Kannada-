# Voice of Kannada (ಕನ್ನಡದ ಧ್ವನಿ) Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_PORT=5173

# Gemini API Key (Required for live AI tutor dialogues)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Service Provider Toggles (for zero-vendor-lockin)
# LLM_PROVIDER: "gemini" or "offline" (defaults to gemini if key present, else offline)
LLM_PROVIDER=gemini

# STT_PROVIDER: "web_speech" (default in browser), "server_mock", or "whisper"
STT_PROVIDER=web_speech

# TTS_PROVIDER: "web_speech" (default in browser), "server_mock"
TTS_PROVIDER=web_speech

# Demo & Offline Safety
# When true, guarantees 100% offline functionality without API keys
FORCE_OFFLINE_DEMO=false
